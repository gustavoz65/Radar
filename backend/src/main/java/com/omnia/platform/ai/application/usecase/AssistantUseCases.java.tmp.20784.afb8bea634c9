package com.omnia.platform.ai.application.usecase;

import com.omnia.platform.ai.application.port.out.AiGatewayPort;
import com.omnia.platform.customer.Customers;
import com.omnia.platform.shared.domain.NotFoundException;
import java.util.ArrayList;
import java.util.List;
import java.util.UUID;
import org.springframework.stereotype.Service;

/**
 * Assistant features. Composes context from other modules' public APIs (never their tables) and
 * delegates wording to the gateway. Deterministic-by-default keeps everything working without an LLM.
 */
@Service
public class AssistantUseCases {

    private final AiGatewayPort gateway;
    private final Customers customers;

    public AssistantUseCases(AiGatewayPort gateway, Customers customers) {
        this.gateway = gateway;
        this.customers = customers;
    }

    public Result summarizeCustomer(UUID customerId) {
        var customer = customers
                .findById(customerId)
                .orElseThrow(() -> new NotFoundException("customer.not-found", "Customer not found"));

        List<String> context = new ArrayList<>();
        context.add("Nome: " + customer.name());
        if (customer.email() != null) {
            context.add("E-mail: " + customer.email());
        }
        if (customer.phone() != null) {
            context.add("Telefone: " + customer.phone());
        }
        String text = gateway.generate(
                "Resumo do cliente para atendimento rápido:", context);
        return new Result(text, gateway.isLive());
    }

    public Result draftMessage(String kind, String customerName) {
        String instruction =
                switch (kind) {
                    case "reminder" -> "Escreva um lembrete cordial de agendamento para " + customerName + ".";
                    case "return" -> "Escreva uma mensagem simpática convidando " + customerName
                            + " a voltar, oferecendo um horário.";
                    case "thanks" -> "Escreva um agradecimento breve a " + customerName + " após o atendimento.";
                    default -> "Escreva uma mensagem cordial para " + customerName + ".";
                };
        List<String> suggestion = List.of(
                "Olá, " + customerName + "! Tudo bem?",
                "Aqui é da sua empresa parceira no Omnia.",
                kindTail(kind));
        return new Result(gateway.generate(instruction, suggestion), gateway.isLive());
    }

    private String kindTail(String kind) {
        return switch (kind) {
            case "reminder" -> "Passando para confirmar seu horário. Podemos contar com você?";
            case "return" -> "Faz um tempinho que não te vemos — que tal agendar uma visita?";
            case "thanks" -> "Obrigado pela preferência! Foi um prazer te atender.";
            default -> "Estamos à disposição!";
        };
    }

    public record Result(String text, boolean live) {}
}
